generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         String
  createdAt    DateTime   @default(now())
  hospital     Hospital?
  bloodBank    BloodBank?
}

model Hospital {
  id        String          @id @default(cuid())
  userId    String          @unique
  user      User            @relation(fields: [userId], references: [id])
  name      String
  district  String
  address   String
  phone     String
  lat       Float?
  lng       Float?
  requests  BloodRequest[]
  donations DonationEvent[]
}

model BloodBank {
  id           String             @id @default(cuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id])
  name         String
  district     String
  address      String
  phone        String
  lat          Float?
  lng          Float?
  inventory    BloodInventory[]
  reservations Reservation[]
  contacts     EmergencyContact[]
}

model BloodInventory {
  id          String    @id @default(cuid())
  bloodBankId String
  bloodBank   BloodBank @relation(fields: [bloodBankId], references: [id])
  bloodType   String
  units       Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([bloodBankId, bloodType])
}

model BloodRequest {
  id           String          @id @default(cuid())
  hospitalId   String
  hospital     Hospital        @relation(fields: [hospitalId], references: [id])
  bloodType    String
  unitsNeeded  Int
  urgencyLevel String          @default("NORMAL")
  status       String          @default("PENDING")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  reservation  Reservation?
  alert        EmergencyAlert?
  donations    DonationEvent[]
}

model Reservation {
  id          String       @id @default(cuid())
  requestId   String       @unique
  request     BloodRequest @relation(fields: [requestId], references: [id])
  bloodBankId String
  bloodBank   BloodBank    @relation(fields: [bloodBankId], references: [id])
  units       Int
  confirmedAt DateTime     @default(now())
}

model EmergencyAlert {
  id        String       @id @default(cuid())
  requestId String       @unique
  request   BloodRequest @relation(fields: [requestId], references: [id])
  message   String
  sentAt    DateTime     @default(now())
  status    String       @default("SENT")
}

model EmergencyContact {
  id          String    @id @default(cuid())
  bloodBankId String
  bloodBank   BloodBank @relation(fields: [bloodBankId], references: [id])
  name        String
  type        String
  phone       String
  district    String
  createdAt   DateTime  @default(now())
}

model DonationEvent {
  id         String        @id @default(cuid())
  requestId  String?
  request    BloodRequest? @relation(fields: [requestId], references: [id])
  hospitalId String
  hospital   Hospital      @relation(fields: [hospitalId], references: [id])
  donorName  String
  bloodType  String
  units      Int
  donatedAt  DateTime      @default(now())
}

model Donor {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  phone       String
  bloodType   String
  lat         Float
  lng         Float
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
